# adsblol (default) or opensky. OpenSky does not answer from Cloudflare, so use it for local dev only.
TRAFFIC_SOURCE=adsblol
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# openAIP key enables worldwide airspace volumes (free account, CC BY-NC 4.0). Without it: FAA data, US airports only.
OPENAIP_API_KEY=
