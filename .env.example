VITE_MAPBOX_TOKEN=
# Optional: custom Mapbox style (mapbox://styles/user/id, user/id, or a styles URL). Default mapbox/dark-v11.
VITE_MAPBOX_STYLE=
# Optional: Mapbox style used in light theme (same formats). Default mapbox/light-v11.
VITE_MAPBOX_STYLE_LIGHT=
# Elevation source: leave unset for free AWS Terrarium, or "mapbox" to use Mapbox Terrain-RGB
VITE_TERRAIN_SOURCE=
